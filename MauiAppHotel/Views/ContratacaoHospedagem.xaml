<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.ContratacaoHospedagem"
             Title="Reserva"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Color4}">

    <ScrollView>
        <VerticalStackLayout Padding="10" Spacing="10">

            <!-- Cabeçalho -->
            <Border BackgroundColor="{StaticResource Primary}"
                    StrokeThickness="0"
                    Padding="10,20">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="2">
                    <Label Text="🏨 Hotel Maui"
                           FontFamily="Kalam"
                           FontSize="38"
                           TextColor="{StaticResource TextoEscuro}" />
                    <Label Text="★ ★ ★ ★ ★"
                           FontSize="16"
                           TextColor="{StaticResource TextoEscuro}" />
                    <Label Text="Cálculo da Diária"
                           FontSize="14"
                           TextColor="{StaticResource TextoEscuro}" />
                </VerticalStackLayout>
            </Border>

            <!-- Hóspedes -->
            <Frame Padding="10" BorderColor="{StaticResource Secondary}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Hóspedes"
                           TextTransform="Uppercase"
                           FontSize="Subtitle"
                           TextColor="{StaticResource TextoEscuro}" />

                    <Grid RowDefinitions="Auto, Auto"
                          ColumnDefinitions="*, *, 2*">

                        <Label Grid.Row="0" Grid.Column="0"
                               Text="Adultos:" />

                        <Label Grid.Row="0" Grid.Column="1"
                               TextColor="{StaticResource TextoEscuro}"
                               Text="{Binding Value}"
                               BindingContext="{x:Reference stp_adultos}" />

                        <Stepper Grid.Row="0" Grid.Column="2"
                                 x:Name="stp_adultos"
                                 Minimum="1"
                                 Maximum="10"
                                 Value="1"
                                 Increment="1" />

                        <Label Grid.Row="1" Grid.Column="0"
                               Text="Crianças:" />

                        <Label Grid.Row="1" Grid.Column="1"
                               TextColor="{StaticResource TextoEscuro}"
                               Text="{Binding Value}"
                               BindingContext="{x:Reference stp_criancas}" />

                        <Stepper Grid.Row="1" Grid.Column="2"
                                 x:Name="stp_criancas"
                                 Minimum="0"
                                 Maximum="10"
                                 Increment="1" />
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <!-- Suíte -->
            <Frame Padding="10" BorderColor="{StaticResource Secondary}">
                <VerticalStackLayout>
                    <Label Text="Escolha sua Suíte"
                           TextTransform="Uppercase"
                           FontSize="Subtitle"
                           TextColor="{StaticResource TextoEscuro}" />

                    <Picker x:Name="pck_quarto"
                            Title="Selecione sua Acomodação" />
                </VerticalStackLayout>
            </Frame>

            <!-- Período -->
            <Frame Padding="10" BorderColor="{StaticResource Secondary}">
                <VerticalStackLayout Spacing="10">

                    <Label Text="Período da Estadia"
                           TextTransform="Uppercase"
                           FontSize="Subtitle"
                           TextColor="{StaticResource TextoEscuro}" />

                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="10">
                        <Label Text="Check-in:" />
                        <DatePicker x:Name="dtpck_checkin"
                                    Format="dd/MM/yyyy" />
                    </HorizontalStackLayout>

                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="10">
                        <Label Text="Check-out:" />
                        <DatePicker x:Name="dtpck_checkout"
                                    Format="dd/MM/yyyy" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Frame>

            <Label Text="Acréscimo por noite: R$ 40,00 por adulto e R$ 20,00 por criança."
                   FontSize="12"
                   TextColor="{StaticResource Gray500}" />

            <Button Text="Avançar"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="{StaticResource TextoEscuro}"
                    Clicked="OnAvancarClicked" />

            <Button Text="ℹ️ Sobre"
                    BackgroundColor="Transparent"
                    TextColor="{StaticResource TextoEscuro}"
                    BorderColor="{StaticResource Primary}"
                    BorderWidth="1"
                    Clicked="OnSobreClicked" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
